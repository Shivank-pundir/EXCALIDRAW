model User {
  id       Uuid    @id @default(uuid())
  email    String  @unique
  password String
  name     String
  photo    String?

  rooms    Room[]  @relation("RoomAdmin")
  chats    Chat[]
}
model Room {
  slug    String @id        // <-- slug is now the primary key, no separate Int id
  adminId Uuid

  admin   User    @relation("RoomAdmin", fields: [adminId], references: [id])
  chats   Chat[]
}

model Chat {
  id      Int    @id @default(autoincrement())
  roomId  String            // <-- now matches Room.slug directly
  userId  Uuid
  message String

  room    Room    @relation(fields: [roomId], references: [slug])
  user    User    @relation(fields: [userId], references: [id])
}